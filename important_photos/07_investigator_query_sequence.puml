@startuml BudgetDarpanInvestigatorSequence
!include _theme.puml
title Budget Darpan — Investigator Query Sequence
caption The live Render API routes safely; full vector retrieval is available in local mode
autonumber

actor Citizen
participant "React Investigator\nVercel" as UI
participant "DRF Query API\nRender" as API
participant "Language Detector" as Lang
participant "Intent Router" as Router
participant "Capability Gate\nhosted / local" as Mode
participant "Fact Selector" as Facts
participant "Hybrid Retriever" as Retrieval
database "Neon PostgreSQL\n(SQLite locally)" as DB
database "Local Chroma\n(Pinecone optional)" as Vector
participant "Safe Composer" as Composer
participant "Optional Local Ollama Chat" as Ollama

Citizen -> UI : type / edit voice transcript
UI -> API : POST /api/v1/investigator/query\nquestion + project_id + session_id?
API -> Lang : detect_language(question)
Lang --> API : en | ne | romanized_ne
API -> Router : route_question(question, has_project)
Router --> API : explicit InvestigationRoute
API -> Mode : inspect configured capabilities

alt DATABASE_QUERY
  API -> Facts : select exact project facts
  Facts -> DB : allocation, award, payments, progress
  DB --> Facts : Decimal values + provenance
  Facts --> API : structured facts
else DOCUMENT_RAG
  alt full local RAG available
    API -> Retrieval : project-filtered evidence query
    Retrieval -> Vector : semantic candidates
    Vector --> Retrieval : chunks + scores + metadata
    Retrieval -> DB : page text, links and review state
    DB --> Retrieval : accepted cited pages
    Retrieval --> API : ranked citations
  else hosted Render preview
    API -> DB : reviewed evidence metadata + official URLs
    DB --> API : deterministic cited evidence/facts
  end
else ANOMALY_EXPLANATION
  API -> DB : active flags and rule payload
  DB --> API : reason + data + threshold + recommendation
else PROJECT_INVESTIGATION
  API -> Facts : full money trail
  Facts -> DB
  DB --> Facts
  alt full local RAG available
    API -> Retrieval : allocation/audit/procurement evidence
    Retrieval -> Vector
    Vector --> Retrieval
  else hosted Render preview
    API -> DB : reviewed catalogue evidence
    DB --> API : citations + official URLs
  end
end

API -> Composer : route + language + facts + citations
opt local generation enabled and evidence bounded
  Composer -> Ollama : context-limited prompt
  Ollama --> Composer : candidate wording
  Composer -> Composer : reject unsupported amounts/dates
end
Composer --> API : answer + citations + visualizations
API -> DB : store chat message if authenticated session
API --> UI : stable response envelope
UI --> Citizen : localized answer, graph and citation cards
Citizen -> UI : open cited document page

note over API,Composer
  No selected project + project-specific question
  → INSUFFICIENT_EVIDENCE, not a guessed project.
end note
@enduml
