@startuml BudgetDarpanDeployment
!include _theme.puml
title Budget Darpan — Deployment Architecture
caption Live Vercel + Render + Neon deployment with a separate full local AI mode
left to right direction

node "Presentation Laptop — Verified Demo" as Laptop #E8F4F1 {
  artifact "React Vite\nlocalhost:5173" as LocalUI
  artifact "Django DRF\nlocalhost:8000" as LocalAPI
  artifact "Mock Identity Django\nlocalhost:8001" as LocalID
  database "SQLite" as SQLite
  database "ChromaDB" as LocalChroma
  artifact "Ollama\nqwen2.5:3b\nnomic-embed-text-v2-moe" as LocalOllama
  artifact "Tesseract + Poppler\nnep+eng OCR" as LocalOCR
  folder "Ignored local PDFs / media" as LocalMedia
}

cloud "Live Public Deployment" as Cloud BLUESOFT {
  node "Vercel — budget-darpan-nepal" as Vercel {
    artifact "React + Vite SPA\nHTTPS + React Router rewrites" as CloudUI
    component "Same-origin reverse proxy\n/api/* · /identity/*" as EdgeProxy
  }
  node "Render — Singapore / Free" as Compute {
    artifact "budget-darpan-api\nDjango DRF + Gunicorn" as CloudAPI
    artifact "budget-darpan-identity\nIndependent Django service" as CloudID
  }
  database "Neon PostgreSQL\nproduction branch" as Postgres
  folder "Hosted evidence catalogue\nmetadata + reviewed facts + official URLs" as HostedCatalogue
}

cloud "Official Government Sources\nmunicipal sites · OAG · e-GP" as Sources

package "Future Production Additions — Not Live" #F7F3EE {
  cloud "S3-compatible object storage\npermitted source PDFs" as ObjectStore
  cloud "Hosted multilingual embeddings/chat\nor paid Ollama machine" as HostedAI
  cloud "Pinecone\noptional vector provider" as CloudVector
}

actor "Browser" as Browser
Browser --> LocalUI : local demo
LocalUI --> LocalAPI
LocalUI --> LocalID
LocalAPI --> SQLite
LocalAPI --> LocalChroma
LocalAPI --> LocalOllama
LocalAPI --> LocalOCR
LocalAPI --> LocalMedia

Browser --> CloudUI : HTTPS public preview
CloudUI --> EdgeProxy : first-party browser requests
EdgeProxy --> CloudAPI : HTTPS /api/v1\nsession cookie + CSRF
EdgeProxy --> CloudID : HTTPS verification\nstart + confirm
CloudAPI --> CloudID : server-to-server code exchange\nclient secret + RS256 verification
CloudAPI --> Postgres : projects · documents · users\nfeedback · anomalies · chat
CloudAPI --> HostedCatalogue
HostedCatalogue --> Postgres
CloudUI --> Sources : open official source URL

CloudAPI ..> CloudVector : future full hosted RAG
CloudAPI ..> ObjectStore : future durable PDF viewer
CloudAPI ..> HostedAI : future hosted embeddings/generation

note bottom of Laptop
  Full local evidence mode:
  OCR + reviewed PDFs + embeddings + Chroma
  + optional Qwen generation.
end note

note bottom of Cloud
  Live judge preview: structured APIs, PostgreSQL,
  evidence catalogue, official links, deterministic
  evidence-safe investigator, auth and mock verification.
  Render Free may cold-start; its disk is ephemeral.
end note

legend bottom
  Solid arrow = deployed and active · Dashed arrow = future addition
  Environment secrets live in ignored .env files locally
  and platform secret managers in deployment—never in Git or frontend code.
endlegend
@enduml
