# Django
BUDGET_DARPAN_DEBUG=True
SECRET_KEY=replace-with-a-long-random-local-secret
ALLOWED_HOSTS=localhost,127.0.0.1
# Leave blank for backend/db.sqlite3; set a PostgreSQL URL in deployment.
DATABASE_URL=
CORS_ALLOWED_ORIGINS=http://localhost:5173

# AI services (activated in the investigator/RAG phase)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen2.5:3b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text-v2-moe
VECTOR_DB_PROVIDER=chroma
PINECONE_API_KEY=
PINECONE_INDEX=budget-darpan
PINECONE_NAMESPACE=public-budget-documents
CHROMA_DB_DIR=../chroma_db

# Mock verification service (activated in the verification phase)
MOCK_IDENTITY_SERVER_URL=http://localhost:8001
MOCK_IDENTITY_PUBLIC_KEY=
CITIZEN_HASH_SECRET=replace-with-a-separate-long-random-local-secret

# Upload limits
MAX_UPLOAD_MB=20

# Phase 2 document extraction and OCR
OCR_LANGUAGES=nep+eng
OCR_DPI=220
OCR_MIN_TEXT_CHARS=80
OCR_MIN_QUALITY_SCORE=0.62
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# Optional. Leave blank when pdftoppm/pdfinfo are already available on PATH.
POPPLER_PATH=
EVIDENCE_MANIFEST=../datasets/manifest.csv
